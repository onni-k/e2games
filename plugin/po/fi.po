msgid "Pinball"
msgstr "Flipperi"

msgid "Select a game"
msgstr "Valitse peli"

msgid "OK: play    EXIT: close"
msgstr "OK: pelaa    EXIT: sulje"

msgid "Games for your receiver"
msgstr "Pelejä vastaanottimeen"

msgid "Score"
msgstr "Pisteet"

msgid "High score"
msgstr "Ennätys"

msgid "Balls"
msgstr "Pallot"

msgid "Multiplier"
msgstr "Kerroin"

msgid "Controls"
msgstr "Ohjaus"

msgid "LEFT / RED: left flipper"
msgstr "VASEN / PUNAINEN: vasen maila"

msgid "RIGHT / BLUE: right flipper"
msgstr "OIKEA / SININEN: oikea maila"

msgid "UP: both flippers"
msgstr "YLÖS: molemmat mailat"

msgid "OK / DOWN: hold and release to launch the ball"
msgstr "OK / ALAS: pidä pohjassa ja vapauta, niin pallo lähtee"

msgid "EXIT: back to menu"
msgstr "EXIT: takaisin valikkoon"

msgid "Light all three green targets for a bonus and a higher multiplier."
msgstr "Sytytä kaikki kolme vihreää maalia, niin saat bonuksen ja suuremman kertoimen."

msgid "GAME OVER"
msgstr "PELI PÄÄTTYI"

msgid "New high score!"
msgstr "Uusi ennätys!"

msgid "Press OK for a new game"
msgstr "Uusi peli: paina OK"

msgid "Ball saved!"
msgstr "Pallo pelastettu!"

msgid "Bonus!"
msgstr "Bonus!"

msgid "Hold OK and release to launch"
msgstr "Pidä OK pohjassa ja vapauta, niin pallo lähtee"

msgid "Solitaire"
msgstr "Pasianssi"

msgid "Moves"
msgstr "Siirrot"

msgid "Time"
msgstr "Aika"

msgid "Arrows: move the cursor"
msgstr "Nuolet: siirrä kohdistinta"

msgid "OK: pick up cards / place them"
msgstr "OK: poimi kortit / aseta ne"

msgid "OK twice on a card: send it to the foundation"
msgstr "OK kahdesti kortilla: siirrä se loppupinoon"

msgid "OK on the stock: turn a new card"
msgstr "OK pakalla: käännä uusi kortti"

msgid "RED: undo"
msgstr "PUNAINEN: peru siirto"

msgid "GREEN: card to the foundation"
msgstr "VIHREÄ: kortti loppupinoon"

msgid "YELLOW: new game"
msgstr "KELTAINEN: uusi peli"

msgid "BLUE: turn a card from the stock"
msgstr "SININEN: käännä kortti pakasta"

msgid "EXIT: cancel selection / back to menu"
msgstr "EXIT: peru valinta / takaisin valikkoon"

msgid "Invalid move"
msgstr "Siirto ei kelpaa"

msgid "You won!"
msgstr "Voitit!"

msgid "Press YELLOW for a new game"
msgstr "Uusi peli: paina KELTAISTA"

msgid "Finishing..."
msgstr "Viimeistellään..."
